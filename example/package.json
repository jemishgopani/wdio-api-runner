{
  "name": "wdio-api-runner-example",
  "version": "1.0.0",
  "description": "Example project demonstrating wdio-api-runner features",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:api": "wdio run wdio.conf.ts --spec \"./test/specs/api/**\"",
    "test:assertions": "wdio run wdio.conf.ts --spec \"./test/specs/assertions/**\"",
    "test:auth": "wdio run wdio.conf.ts --spec \"./test/specs/auth/**\"",
    "test:graphql": "wdio run wdio.conf.ts --spec \"./test/specs/graphql/**\"",
    "test:browser": "wdio run wdio.conf.ts --spec \"./test/specs/browser/**\"",
    "test:observability": "wdio run wdio.conf.ts --spec \"./test/specs/observability/**\"",
    "test:e2e": "wdio run wdio.conf.ts --spec \"./test/specs/e2e/**\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chai": "^5.2.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@wdio/cli": "^9.23.3",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "chai": "^5.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0",
    "wdio-api-runner": "file:.."
  }
}
